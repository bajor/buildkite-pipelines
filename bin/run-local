#!/usr/bin/env bash
# Runs every check of a pipeline template in the current directory, the same
# scripts Buildkite runs, so failures show up before a push. Every check runs
# even after one fails; the exit status is nonzero if any failed.
# Usage: run-local <pipeline>
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pipeline="${1:?usage: run-local <pipeline>}"
template="$plugin_dir/pipelines/$pipeline.yml"
if [[ ! "$pipeline" =~ ^[a-z][a-z0-9-]*$ || ! -f "$template" ]]; then
  echo "run-local: unknown pipeline '$pipeline'" >&2
  exit 1
fi

ran=0
failed=""
# Template steps name their check as "check: <name>". The checks read from
# fd 0, so the list is read from fd 3 to keep them from consuming it.
while read -r check <&3; do
  echo "--- $check"
  ran=$((ran + 1))
  "$plugin_dir/checks/$check.sh" || failed="$failed $check"
done 3< <(sed -n 's/^ *check: *\([a-z0-9-]*\) *$/\1/p' "$template")

if ((ran == 0)); then
  echo "run-local: no checks found in $template" >&2
  exit 1
fi
if [[ -n "$failed" ]]; then
  echo "+++ Failed:$failed" >&2
  exit 1
fi
echo "+++ All $ran checks of $pipeline passed."
